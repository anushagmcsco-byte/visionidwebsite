# ---------- VisionID website: GoDaddy / Apache settings ----------
DirectoryIndex index.html
Options -Indexes

# Force HTTPS and use visionid.in (no www)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://visionid.in%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.visionid\.in$ [NC]
  RewriteRule ^ https://visionid.in%{REQUEST_URI} [L,R=301]
  # Vite/React admin route; keep actual PHP API and asset files intact.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; img-src 'self' data: blob: https://doyjpqtrqwbykbsvsylm.supabase.co; connect-src 'self' https://doyjpqtrqwbykbsvsylm.supabase.co; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"

  # Always fetch the newest page and Industry Pulse feed
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html application/json text/css application/javascript image/svg+xml
</IfModule>

# Hide dotfiles and backups
<FilesMatch "^\.|\.(bak|old|log|sql|py)$">
  Require all denied
</FilesMatch>

<Files "config.php">
  Require all denied
</Files>
